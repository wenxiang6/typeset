{
  "name": "geo-weekly-paiban",
  "private": true,
  "version": "1.0.0",
  "description": "地理周刊排版编辑器（服务器版）",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "import:verify": "node ../backend/tools/import/verify.mjs",
    "import:debug": "node ../backend/tools/import/cli.mjs",
    "preview": "vite preview",
    "mcp": "node ../backend/tools/paiban-mcp/server.mjs",
    "mcp:selftest": "node ../backend/tools/paiban-mcp/selftest.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:check": "node scripts/serve.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "alova": "^3.5.5",
    "antd": "^6.6.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "author": {
    "name": "wenxiang"
  },
  "license": "MIT"
}
