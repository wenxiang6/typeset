# 复制为 .env 并填写。.env 不要提交到仓库。
# 对外访问地址（拼访问链接用，结尾不带斜杠）
BASE_URL=http://47.253.176.114:9705
# 管理后台密钥：openssl rand -hex 16 生成
ADMIN_SECRET=REPLACE_ME
# PostgreSQL 密码：openssl rand -hex 16 生成
POSTGRES_PASSWORD=REPLACE_ME

# 裸域名门禁（首次启动的默认值；之后在 /admin 后台「访问门禁」里改，存数据库即时生效）
GATE_PASSWORD=admin123
TRIAL_MINUTES=10
